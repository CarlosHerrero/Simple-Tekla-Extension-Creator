<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<RootNamespace>Simple_Tekla_Extension_Creator.Tool</RootNamespace>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackAsTool>true</PackAsTool>
	<ToolCommandName>simple-tekla-extension-creator</ToolCommandName>
	<PackageId>SimpleTeklaExtensionCreator</PackageId>
	<Version>1.0.0</Version>
	<Authors>CarlosHerrero</Authors>
	<Description>Scaffolds new Tekla Structures extension starter projects (Console, WinForms, or WPF), optionally replacing the default beam-insertion example with Tekla Open API code extracted from an existing macro (.cs) file. Headless CLI tool.</Description>
	<PackageProjectUrl>https://github.com/CarlosHerrero/Simple-Tekla-Extension-Creator</PackageProjectUrl>
	<RepositoryUrl>https://github.com/CarlosHerrero/Simple-Tekla-Extension-Creator</RepositoryUrl>
	<PackageTags>tekla;tekla-structures;scaffolding;dotnet-tool;code-generator</PackageTags>
	<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
	<None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Simple Tekla Extension Creator.Core\Simple Tekla Extension Creator.Core.csproj" />
  </ItemGroup>

</Project>
