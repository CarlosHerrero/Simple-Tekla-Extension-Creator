<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Simple_Tekla_Extension_Creator</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);Copilot Skill\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Copilot Skill\Copilot Skill.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Simple Tekla Extension Creator.Core\Simple Tekla Extension Creator.Core.csproj" />
  </ItemGroup>

</Project>
